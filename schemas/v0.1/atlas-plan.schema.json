{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jvogan/codex-surface-atlas/blob/main/schemas/v0.1/atlas-plan.schema.json",
  "title": "Codex Surface Atlas plan v0.1",
  "type": "object",
  "required": ["schema_version", "atlas_id", "scope", "resource_profile", "stages"],
  "properties": {
    "schema_version": {"const": "codex-surface-atlas-plan/v0.1"},
    "atlas_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "created_at": {"type": "string", "minLength": 1},
    "mode": {"type": "string", "minLength": 1},
    "disease": {"type": "object"},
    "scope": {
      "type": "object",
      "required": ["research_target_cap", "completeness_language", "coverage_claim"],
      "properties": {
        "research_target_cap": {"type": "null"},
        "completeness_language": {"const": "searched-in-scope target census"},
        "coverage_claim": {
          "enum": ["planned", "in-progress", "complete_within_recorded_scope", "partial", "blocked"]
        }
      },
      "additionalProperties": true
    },
    "resource_profile": {
      "type": "object",
      "required": ["structure_tiers"],
      "properties": {
        "structure_tiers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["tier_id", "max_targets"],
            "properties": {
              "tier_id": {"type": "string", "pattern": "^structure-"},
              "max_targets": {"type": "integer", "minimum": 1}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["stage_id", "state"],
        "properties": {
          "stage_id": {"type": "string", "minLength": 1},
          "state": {"enum": ["pending", "in-progress", "blocked", "complete", "failed", "skipped"]},
          "depends_on": {"type": "array", "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
