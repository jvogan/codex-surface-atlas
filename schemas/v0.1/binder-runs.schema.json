{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codex-surface-binder-run-collection/v0.1",
  "title": "binder-runs.schema.json",
  "description": "Shape contract. Runtime research_intake additionally verifies file bytes/hashes, identities, joins, controls, finite numbers and endpoint/unit compatibility.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "codex-surface-binder-run-collection/v0.1"
    },
    "atlas_id": {
      "type": "string",
      "minLength": 1
    },
    "data_status": {
      "enum": [
        "synthetic",
        "research"
      ]
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "run_id": {
            "type": "string",
            "minLength": 1
          },
          "campaign_id": {
            "type": "string",
            "minLength": 1
          },
          "target_id": {
            "type": "string",
            "minLength": 1
          },
          "target_construct": {
            "$ref": "#/$defs/construct"
          },
          "generator": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "$ref": "#/$defs/source"
              },
              "seed": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "seed_gap": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "name",
              "version",
              "source",
              "seed"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "seed": {
                      "type": "null"
                    }
                  }
                },
                "then": {
                  "required": [
                    "seed_gap"
                  ]
                }
              }
            ]
          },
          "evaluation_protocol": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "$ref": "#/$defs/source"
              }
            },
            "required": [
              "id",
              "version",
              "source"
            ]
          },
          "source": {
            "$ref": "#/$defs/source"
          },
          "stages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "enum": [
                    "completed",
                    "partial",
                    "failed",
                    "not-run"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "name",
                "status",
                "reason"
              ]
            },
            "minItems": 1
          },
          "controls_status": {
            "enum": [
              "passed",
              "failed",
              "not-run",
              "unresolved"
            ]
          },
          "candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "candidate_id": {
                  "type": "string",
                  "minLength": 1
                },
                "role": {
                  "enum": [
                    "candidate",
                    "positive-control",
                    "negative-control"
                  ]
                },
                "construct_id": {
                  "type": "string",
                  "minLength": 1
                },
                "sequence": {
                  "type": "string",
                  "pattern": "^[ACDEFGHIKLMNPQRSTVWYXBZUO]+$"
                },
                "sequence_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "evidence_class": {
                  "const": "computational-design-hypothesis"
                },
                "source": {
                  "$ref": "#/$defs/source"
                },
                "lineage": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "run_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "candidate_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "sequence_sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      "source": {
                        "$ref": "#/$defs/source"
                      }
                    },
                    "required": [
                      "run_id",
                      "candidate_id",
                      "sequence_sha256",
                      "source"
                    ]
                  },
                  "minItems": 0
                },
                "observations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "observation_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "seed": {
                        "type": "integer"
                      },
                      "status": {
                        "enum": [
                          "scored",
                          "failed",
                          "not-run"
                        ]
                      },
                      "metrics": {
                        "type": "object",
                        "additionalProperties": {
                          "type": [
                            "number",
                            "null"
                          ]
                        }
                      },
                      "reason": {
                        "type": "string",
                        "minLength": 1
                      },
                      "source": {
                        "$ref": "#/$defs/source"
                      }
                    },
                    "required": [
                      "observation_id",
                      "seed",
                      "status",
                      "metrics",
                      "reason",
                      "source"
                    ]
                  },
                  "minItems": 0
                },
                "promotion": {
                  "type": "object",
                  "properties": {
                    "decision": {
                      "enum": [
                        "promoted",
                        "not-promoted",
                        "pending"
                      ]
                    },
                    "rationale": {
                      "type": "string",
                      "minLength": 1
                    },
                    "source": {
                      "$ref": "#/$defs/source"
                    }
                  },
                  "required": [
                    "decision",
                    "rationale",
                    "source"
                  ]
                },
                "acceptance_status": {
                  "enum": [
                    "passed",
                    "failed",
                    "not-run",
                    "unresolved"
                  ]
                },
                "acceptance_rule": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "modifications": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "candidate_id",
                "role",
                "construct_id",
                "sequence",
                "sequence_sha256",
                "evidence_class",
                "source",
                "lineage",
                "observations",
                "promotion",
                "description",
                "modifications"
              ],
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "role": {
                        "enum": [
                          "positive-control",
                          "negative-control"
                        ]
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "acceptance_status",
                      "acceptance_rule"
                    ]
                  }
                }
              ]
            },
            "minItems": 1
          }
        },
        "required": [
          "run_id",
          "campaign_id",
          "target_id",
          "target_construct",
          "generator",
          "evaluation_protocol",
          "source",
          "stages",
          "controls_status",
          "candidates"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "atlas_id",
    "data_status",
    "records"
  ],
  "$defs": {
    "artifact": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "storage": {
          "const": "workspace"
        }
      },
      "required": [
        "path",
        "sha256",
        "bytes"
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "artifact": {
          "$ref": "#/$defs/artifact"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "artifact",
        "locator"
      ]
    },
    "construct": {
      "type": "object",
      "properties": {
        "construct_id": {
          "type": "string",
          "minLength": 1
        },
        "sequence": {
          "type": "string",
          "pattern": "^[ACDEFGHIKLMNPQRSTVWYXBZUO]+$"
        },
        "sequence_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "modifications": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      },
      "required": [
        "construct_id",
        "sequence",
        "sequence_sha256",
        "description",
        "modifications",
        "source"
      ]
    }
  }
}
